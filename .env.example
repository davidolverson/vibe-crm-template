# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — REQUIRED
# Use Neon PostgreSQL. Connection string must include ?sslmode=require.
# Get from: https://console.neon.tech → Project → Connection String
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# BETTER AUTH — REQUIRED
# Generate BETTER_AUTH_SECRET: openssl rand -base64 32
# BETTER_AUTH_URL should be your production domain in prod, http://localhost:3000 in dev
# ─────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# APP — REQUIRED
# Set to your production domain (e.g., https://vibe.mycompany.com)
# Used for auth redirects, email links, and API callbacks
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION — RECOMMENDED
# 32-byte hex key for AES-256-GCM encryption of sensitive tenant data
# Generate: openssl rand -hex 32
# Critical for encrypting Twilio/Stripe credentials stored in database
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE — OPTIONAL (if using billing)
# Get keys from: https://dashboard.stripe.com/apikeys
# Create products + prices in Dashboard, copy price IDs (price_...)
# Webhook secret from Dashboard → Webhooks → Signing secret
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_ENTERPRISE=price_

# ─────────────────────────────────────────────────────────────────────────────
# POSTMARK — OPTIONAL (if using email sequences)
# Get Server Token from: https://account.postmarkapp.com/ → Servers → API Tokens
# Set webhook URL in Postmark to: https://your-app.com/api/webhooks/postmark
# Generate POSTMARK_WEBHOOK_SECRET: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=noreply@example.com
POSTMARK_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# CRON JOBS — OPTIONAL (if using scheduled tasks)
# Secret for authenticating cron endpoints (/api/cron/*)
# Generate: openssl rand -hex 32
# Set in Vercel → Project → Cron Jobs (vercel.json handles scheduling)
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# TWILIO — OPTIONAL (if using SMS/calling)
# Per-tenant Account SID/Auth Token live encrypted in the DB via Settings → Twilio.
# These global vars are only needed for inbound webhook signature validation
# and Voice SDK access tokens (click-to-call).
#
# - TWILIO_WEBHOOK_AUTH_TOKEN = the Auth Token for the Twilio account that
#   signs inbound webhooks (usually the same Master Account you use for dev).
#   Leave blank locally to skip signature checks (dev convenience).
# - TWILIO_API_KEY_SID / TWILIO_API_KEY_SECRET = Voice SDK API Key pair
#   (console.twilio.com → Account → API Keys). Only required for click-to-call.
# ─────────────────────────────────────────────────────────────────────────────
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Public URL Twilio sends webhooks to (derives from NEXT_PUBLIC_APP_URL):
#   /api/webhooks/twilio/sms     — inbound SMS + status callbacks
#   /api/webhooks/twilio/voice   — call status callbacks

# ─────────────────────────────────────────────────────────────────────────────
# POSTMARK WEBHOOK — OPTIONAL (open/click/bounce tracking)
# Optional HTTP Basic auth token on the Postmark webhook URL. If set, Postmark
# must be configured with the same Basic credentials in its webhook setup.
# Format: base64(user:pass). Leave blank to disable auth (not recommended in prod).
# ─────────────────────────────────────────────────────────────────────────────
POSTMARK_WEBHOOK_BASIC_AUTH=

# ─────────────────────────────────────────────────────────────────────────────
# QUICKBOOKS ONLINE — OPTIONAL (if using financial sync)
# Register app at: https://developer.intuit.com → Dashboard → Create an app
# Scopes: com.intuit.quickbooks.accounting
# Redirect URI (local): http://localhost:3000/api/auth/quickbooks/callback
# Redirect URI (prod):  https://www.example.com/api/auth/quickbooks/callback
# Set QBO_SANDBOX=true while using sandbox company. Unset for production realms.
# ─────────────────────────────────────────────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/auth/quickbooks/callback
QBO_SANDBOX=true

# Platform super-admin emails (comma-separated)
ADMIN_EMAILS=

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC LANDING — waitlist + contact form inbox routing
# Leave unset in local dev to simulate sends (logs to stdout).
# ─────────────────────────────────────────────────────────────────────────────
# Signup notifications from /api/waitlist land here:
WAITLIST_INBOX=owner@example.com
# Messages from /api/contact land here:
CONTACT_INBOX=owner@example.com
# Starting count of claimed Founding 50 spots (drives the progress bar):
FOUNDING_CLAIMED_COUNT=0
# Email sender identity (applies to both Resend and Postmark):
EMAIL_FROM=hello@example.com
# Resend API key — preferred provider (3,000 emails/month free):
RESEND_API_KEY=
# Postmark is the fallback provider if RESEND_API_KEY is unset (POSTMARK_SERVER_TOKEN above).
# Legacy Postmark-only env vars (still read as fallback by public-email.ts):
POSTMARK_FROM_EMAIL=
# Sender for Resend-delivered auth/transactional mail (falls back to EMAIL_FROM):
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# AI DRAFTING — OPTIONAL (email/SMS drafts + rewrite)
# Anthropic API key. Leave blank to disable AI drafting (routes return 503).
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Set to "true" to report AI usage to a Stripe usage meter.
STRIPE_AI_METER_ENABLED=false

# Optional legacy alias for NEXT_PUBLIC_APP_URL (server-only fallback):
APP_URL=
