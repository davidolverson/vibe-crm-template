generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────
// ENUMS
// ──────────────────────────────────────

enum ContactStatus {
  new
  contacted
  qualified
  nurturing
  customer
  lost
}

enum DealStatus {
  open
  won
  lost
}

enum TaskStatus {
  pending
  completed
  cancelled
}

enum ActivityType {
  note
  call
  sms
  email
  stage_change
  task_completed
  form_submission
}

enum IdentityType {
  email
  phone
}

enum AssignmentRuleType {
  round_robin
  default_owner
}

enum LeadSource {
  website
  referral
  social
  ad
  form_submission
  other
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum NotificationType {
  lead_assigned
  task_overdue
  task_due_soon
  deal_stage_changed
  automation_fired
  system_alert
  financial_alert
}

enum NotificationChannel {
  in_app
  email
  both
}

enum AlertRuleType {
  revenue_drop
  ar_aging
  invoice_overdue
  payment_received
}

// ──────────────────────────────────────
// BETTER AUTH TABLES
// ──────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  @@map("users")
}

model Session {
  id                     String   @id
  userId                 String   @map("user_id")
  token                  String   @unique
  expiresAt              DateTime @map("expires_at")
  ipAddress              String?  @map("ip_address")
  userAgent              String?  @map("user_agent")
  activeOrganizationId   String?  @map("active_organization_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token") @db.Text
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  members     Member[]
  invitations Invitation[]
  tenant      Tenant?

  @@map("organizations")
}

model Member {
  id             String   @id
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("members")
}

model Invitation {
  id             String   @id
  email          String
  organizationId String   @map("organization_id")
  role           String
  status         String   @default("pending")
  inviterId      String   @map("inviter_id")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ──────────────────────────────────────
// CORE TABLES
// ──────────────────────────────────────

model Tenant {
  id                   String        @id @default(uuid())
  name                 String
  slug                 String        @unique
  plan                 String        @default("free")
  organizationId       String?       @unique @map("organization_id")
  organization         Organization? @relation(fields: [organizationId], references: [id])
  timezone             String        @default("America/New_York") @map("timezone")
  currency             String        @default("USD") @map("currency")
  stripeCustomerId     String?       @unique @map("stripe_customer_id")
  stripeSubscriptionId String?       @unique @map("stripe_subscription_id")
  stripePriceId        String?       @map("stripe_price_id")
  trialEndsAt          DateTime?     @map("trial_ends_at")
  currentPeriodEnd     DateTime?     @map("current_period_end")
  subscriptionStatus   String        @default("trialing") @map("subscription_status") // trialing | active | past_due | canceled | unpaid
  onboardingComplete   Boolean       @default(false) @map("onboarding_complete")
  aiFeatureEnabled     Boolean       @default(true) @map("ai_feature_enabled")
  aiMonthlyBudget      Int           @default(1500) @map("ai_monthly_budget") // included AI drafts per month
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  users              TenantUser[]
  roles              Role[]
  contacts           Contact[]
  pipelines          Pipeline[]
  forms              Form[]
  assignmentRules    AssignmentRule[]
  notifications      Notification[]
  pushTokens         PushToken[]
  auditLogs          AuditLog[]
  emailTemplates     EmailTemplate[]
  twilioConfig       TenantTwilioConfig?
  sequences          Sequence[]
  automations        Automation[]
  usageCounters      UsageCounter[]
  sites              Site[]
  businessEntities   BusinessEntity[]
  qboConnection      QboConnection?
  qboInvoices        QboInvoice[]
  qboPayments        QboPayment[]
  jvAgreements       JvAgreement[]
  socialAccounts     SocialAccount[]
  socialLeadWebhooks SocialLeadWebhook[]
  leads              Lead[]
  blogPosts          BlogPost[]
  alertRules         AlertRule[]
  idxConfig          TenantIdxConfig?
  aiUsageEvents      AiUsageEvent[]

  @@map("tenants")
}

// ──────────────────────────────────────
// AI ASSISTANCE (Phase 11)
// ──────────────────────────────────────

enum AiFeature {
  draft_email
  draft_sms
  rewrite
}

model AiUsageEvent {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  userId        String    @map("user_id") // Better Auth user id
  feature       AiFeature
  model         String // e.g. claude-sonnet-4-6
  inputTokens   Int       @map("input_tokens")
  outputTokens  Int       @map("output_tokens")
  cachedTokens  Int       @default(0) @map("cached_tokens")
  costCents     Int       @map("cost_cents")
  durationMs    Int       @map("duration_ms")
  success       Boolean   @default(true)
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, feature, createdAt])
  @@map("ai_usage_events")
}

model SystemFlag {
  key       String   @id
  boolValue Boolean  @default(false) @map("bool_value")
  strValue  String?  @map("str_value")
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("system_flags")
}

model TenantIdxConfig {
  id         String   @id @default(uuid())
  tenantId   String   @unique @map("tenant_id")
  vendor     String   @default("")
  widgetCode String   @default("") @map("widget_code") @db.Text
  disclaimer String   @default("") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_idx_configs")
}

model TenantUser {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id") // Better Auth user ID
  roleId    String    @map("role_id")
  deletedAt DateTime? @map("deleted_at") // Soft delete
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions Permission[]
  users       TenantUser[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String   @map("role_id")
  resource  String
  action    String
  scope     String   @default("all") // "all" | "assigned"
  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

// ──────────────────────────────────────
// CONTACTS
// ──────────────────────────────────────

model Contact {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  name             String
  email            String?
  phone            String?
  company          String?
  status           ContactStatus @default(new)
  assignedToUserId String?       @map("assigned_to_user_id")
  source           String?
  leadCreatedAt    DateTime      @default(now()) @map("lead_created_at")
  firstContactedAt DateTime?     @map("first_contacted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  smsOptOut   Boolean @default(false) @map("sms_opt_out")
  emailOptOut Boolean @default(false) @map("email_opt_out")

  entityId String? @map("entity_id")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity              BusinessEntity?      @relation(fields: [entityId], references: [id])
  identities          ContactIdentity[]
  tags                ContactTag[]
  activities          Activity[]
  tasks               Task[]
  deals               Deal[]               @relation("PrimaryContact")
  dealParticipants    DealParticipant[]
  smsMessages         SmsMessage[]
  callLogs            CallLog[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([tenantId, createdAt])
  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, entityId])
  @@map("contacts")
}

model ContactIdentity {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  contactId String       @map("contact_id")
  type      IdentityType
  value     String
  createdAt DateTime     @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, value])
  @@map("contact_identities")
}

model ContactTag {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  contactId String   @map("contact_id")
  tag       String
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId, tag])
  @@map("contact_tags")
}

// ──────────────────────────────────────
// LEADS
// ──────────────────────────────────────

model Lead {
  id                 String     @id @default(uuid())
  tenantId           String     @map("tenant_id")
  name               String
  email              String?
  phone              String?
  source             LeadSource @default(other)
  status             LeadStatus @default(new)
  propertyInterest   String?    @map("property_interest")
  budgetMin          Int?       @map("budget_min")
  budgetMax          Int?       @map("budget_max")
  notes              String?
  assignedTo         String?    @map("assigned_to")
  convertedContactId String?    @map("converted_contact_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities LeadActivity[]

  @@index([tenantId, createdAt])
  @@index([tenantId, assignedTo, status])
  @@index([tenantId, email])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  leadId    String   @map("lead_id")
  type      String // note | call | email | sms
  body      String?
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@map("lead_activities")
}

// ──────────────────────────────────────
// ACTIVITIES & TASKS
// ──────────────────────────────────────

model Activity {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  contactId     String       @map("contact_id")
  type          ActivityType
  body          String?
  userId        String?      @map("user_id")
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId])
  @@index([tenantId, createdAt])
  @@map("activities")
}

model Task {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  contactId        String?    @map("contact_id")
  title            String
  description      String?
  dueAt            DateTime?  @map("due_at")
  status           TaskStatus @default(pending)
  priority         String?    @default("medium")
  assignedToUserId String?    @map("assigned_to_user_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, dueAt])
  @@map("tasks")
}

// ──────────────────────────────────────
// PIPELINE & DEALS
// ──────────────────────────────────────

enum PipelineKind {
  real_estate
  mortgage
  insurance
  investment
  custom
}

model Pipeline {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  name      String
  kind      PipelineKind @default(real_estate)
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]

  @@index([tenantId, isDefault])
  @@index([tenantId, kind])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  pipelineId String   @map("pipeline_id")
  name       String
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([tenantId, pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id                String     @id @default(uuid())
  tenantId          String     @map("tenant_id")
  name              String
  stageId           String     @map("stage_id")
  contactId         String     @map("contact_id")
  value             Decimal?   @db.Decimal(12, 2)
  assignedToUserId  String?    @map("assigned_to_user_id")
  expectedCloseDate DateTime?  @map("expected_close_date")
  closedAt          DateTime?  @map("closed_at")
  status            DealStatus @default(open)
  lostReason        String?    @map("lost_reason")
  stageChangedAt    DateTime   @default(now()) @map("stage_changed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  entityId      String? @map("entity_id")
  jvAgreementId String? @map("jv_agreement_id")

  stage           PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact         Contact           @relation("PrimaryContact", fields: [contactId], references: [id], onDelete: Cascade)
  entity          BusinessEntity?   @relation(fields: [entityId], references: [id])
  jvAgreement     JvAgreement?      @relation(fields: [jvAgreementId], references: [id])
  participants    DealParticipant[]
  dealActivities  DealActivity[]
  jvDistributions JvDistribution[]

  @@index([tenantId, stageId])
  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, entityId])
  @@map("deals")
}

model DealActivity {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  dealId      String   @map("deal_id")
  userId      String?  @map("user_id")
  type        String // note | stage_change | value_change | call | email
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId, dealId])
  @@map("deal_activities")
}

model DealParticipant {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  dealId    String   @map("deal_id")
  contactId String   @map("contact_id")
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([dealId, contactId])
  @@map("deal_participants")
}

// ──────────────────────────────────────
// FORMS & LEAD CAPTURE
// ──────────────────────────────────────

model Form {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  name               String
  active             Boolean  @default(true)
  defaultSequenceId  String?  @map("default_sequence_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultSequence    Sequence?           @relation("FormDefaultSequence", fields: [defaultSequenceId], references: [id], onDelete: SetNull)
  fields             FormField[]
  submissions        FormSubmission[]
  sites              Site[]
  socialLeadWebhooks SocialLeadWebhook[]

  @@map("forms")
}

model FormField {
  id        String   @id @default(uuid())
  formId    String   @map("form_id")
  tenantId  String   @map("tenant_id")
  label     String
  type      String // text, email, phone, select, textarea
  required  Boolean  @default(false)
  position  Int
  options   String? // JSON string for select options
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([tenantId, formId])
  @@map("form_fields")
}

model FormSubmission {
  id          String   @id @default(uuid())
  formId      String   @map("form_id")
  tenantId    String   @map("tenant_id")
  contactId   String?  @map("contact_id")
  payloadJson Json     @map("payload_json")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  form           Form            @relation(fields: [formId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([tenantId, formId])
  @@map("form_submissions")
}

model TrackingEvent {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  contactId        String?  @map("contact_id")
  formSubmissionId String?  @map("form_submission_id")
  utmSource        String?  @map("utm_source")
  utmMedium        String?  @map("utm_medium")
  utmCampaign      String?  @map("utm_campaign")
  createdAt        DateTime @default(now()) @map("created_at")

  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, contactId])
  @@map("tracking_events")
}

// ──────────────────────────────────────
// ASSIGNMENT & AUTOMATION
// ──────────────────────────────────────

model AssignmentRule {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  type              AssignmentRuleType
  configJson        Json               @map("config_json")
  lastAssignedIndex Int                @default(0) @map("last_assigned_index")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
  @@map("assignment_rules")
}

// ──────────────────────────────────────
// NOTIFICATIONS & AUDIT
// ──────────────────────────────────────

model Notification {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  userId        String              @map("user_id")
  type          NotificationType
  title         String
  body          String?
  readAt        DateTime?           @map("read_at")
  channel       NotificationChannel @default(in_app)
  referenceType String?             @map("reference_type")
  referenceId   String?             @map("reference_id")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  token     String
  platform  String // "ios" | "android"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, token])
  @@index([tenantId, userId])
  @@map("push_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ──────────────────────────────────────
// EMAIL TEMPLATES
// ──────────────────────────────────────

enum EmailTemplateCategory {
  follow_up
  listing
  mortgage
  insurance
  investing
}

model EmailTemplate {
  id        String                @id @default(uuid())
  tenantId  String                @map("tenant_id")
  name      String
  subject   String
  body      String
  category  EmailTemplateCategory
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequenceSteps SequenceStep[]

  @@index([tenantId, category])
  @@map("email_templates")
}

// ──────────────────────────────────────
// COMMUNICATION (V0.5)
// ──────────────────────────────────────

enum SmsDirection {
  inbound
  outbound
}

enum SmsStatus {
  queued
  sent
  delivered
  failed
  received
}

enum CallDirection {
  inbound
  outbound
}

enum CallStatus {
  initiated
  ringing
  in_progress
  completed
  no_answer
  busy
  failed
  cancelled
}

model TenantTwilioConfig {
  id          String   @id @default(uuid())
  tenantId    String   @unique @map("tenant_id")
  accountSid  String   @map("account_sid") // encrypted
  authToken   String   @map("auth_token") // encrypted
  twimlAppSid String?  @map("twiml_app_sid")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  phoneNumbers TenantPhoneNumber[]

  @@map("tenant_twilio_configs")
}

model TenantPhoneNumber {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  twilioConfigId String   @map("twilio_config_id")
  phoneNumber    String   @map("phone_number")
  twilioSid      String   @map("twilio_sid")
  friendlyName   String?  @map("friendly_name")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  twilioConfig TenantTwilioConfig @relation(fields: [twilioConfigId], references: [id], onDelete: Cascade)
  smsMessages  SmsMessage[]
  callLogs     CallLog[]

  @@unique([tenantId, phoneNumber])
  @@index([tenantId, isDefault])
  @@map("tenant_phone_numbers")
}

model SmsMessage {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  contactId     String       @map("contact_id")
  phoneNumberId String       @map("phone_number_id")
  direction     SmsDirection
  body          String
  status        SmsStatus    @default(queued)
  twilioSid     String?      @map("twilio_sid")
  userId        String?      @map("user_id") // agent who sent (null for inbound)
  createdAt     DateTime     @default(now()) @map("created_at")

  contact     Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber TenantPhoneNumber @relation(fields: [phoneNumberId], references: [id])

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, twilioSid])
  @@map("sms_messages")
}

model CallLog {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  contactId       String        @map("contact_id")
  phoneNumberId   String        @map("phone_number_id")
  direction       CallDirection
  status          CallStatus    @default(initiated)
  durationSeconds Int?          @map("duration_seconds")
  recordingUrl    String?       @map("recording_url")
  twilioSid       String?       @map("twilio_sid")
  userId          String?       @map("user_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  contact     Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber TenantPhoneNumber @relation(fields: [phoneNumberId], references: [id])

  @@index([tenantId, contactId, createdAt])
  @@map("call_logs")
}

// ──────────────────────────────────────
// SEQUENCES & AUTOMATIONS (V0.5)
// ──────────────────────────────────────

enum SequenceStatus {
  draft
  active
  paused
}

enum SequenceStepType {
  email
  sms
  wait
}

enum EnrollmentStatus {
  active
  completed
  paused
  unsubscribed
}

enum AutomationTrigger {
  form_submitted
  deal_stage_changed
  lead_not_contacted
  contact_created
}

model Sequence {
  id        String         @id @default(uuid())
  tenantId  String         @map("tenant_id")
  name      String
  status    SequenceStatus @default(draft)
  createdBy String?        @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
  forms       Form[]               @relation("FormDefaultSequence")

  @@index([tenantId, status])
  @@map("sequences")
}

model SequenceStep {
  id         String           @id @default(uuid())
  sequenceId String           @map("sequence_id")
  stepOrder  Int              @map("step_order")
  type       SequenceStepType
  templateId String?          @map("template_id") // email template
  smsBody    String?          @map("sms_body")
  delayDays  Int              @default(0) @map("delay_days")
  delayHours Int              @default(0) @map("delay_hours")
  createdAt  DateTime         @default(now()) @map("created_at")

  sequence Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id])

  @@unique([sequenceId, stepOrder])
  @@map("sequence_steps")
}

model SequenceEnrollment {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  sequenceId  String           @map("sequence_id")
  contactId   String           @map("contact_id")
  currentStep Int              @default(0) @map("current_step")
  status      EnrollmentStatus @default(active)
  nextSendAt  DateTime?        @map("next_send_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([tenantId, status, nextSendAt])
  @@index([tenantId, contactId])
  @@map("sequence_enrollments")
}

model EmailSend {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  contactId     String    @map("contact_id")
  templateId    String?   @map("template_id")
  sequenceId    String?   @map("sequence_id")
  postmarkMsgId String?   @map("postmark_msg_id")
  toEmail       String?   @map("to_email")
  status        String    @default("sent") // sent | opened | clicked | bounced | spam_complaint | failed
  bounceType    String?   @map("bounce_type")
  sentAt        DateTime  @default(now()) @map("sent_at")
  openedAt      DateTime? @map("opened_at")
  clickedAt     DateTime? @map("clicked_at")
  bouncedAt     DateTime? @map("bounced_at")

  @@index([tenantId, contactId])
  @@index([tenantId, sequenceId])
  @@index([postmarkMsgId])
  @@map("email_sends")
}

model Automation {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  name           String
  triggerType    AutomationTrigger @map("trigger_type")
  conditionsJson Json?             @map("conditions_json")
  actionsJson    Json              @map("actions_json")
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   AutomationLog[]

  @@index([tenantId, triggerType, enabled])
  @@map("automations")
}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String   @map("automation_id")
  contactId    String   @map("contact_id")
  result       String // success | skipped | error
  errorMessage String?  @map("error_message")
  triggeredAt  DateTime @default(now()) @map("triggered_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, triggeredAt])
  @@map("automation_logs")
}

// ──────────────────────────────────────
// BUSINESS ENTITIES (V1.5)
// ──────────────────────────────────────

model BusinessEntity {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  type      String // real_estate | mortgage | insurance | title | construction | investing | other
  color     String   @default("#D4A017")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  jvAgreements JvAgreement[]
  qboInvoices  QboInvoice[]  @relation("QboInvoiceEntity")
  qboPayments  QboPayment[]  @relation("QboPaymentEntity")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("business_entities")
}

// ──────────────────────────────────────
// QUICKBOOKS (V1.5)
// ──────────────────────────────────────

model QboConnection {
  id             String    @id @default(uuid())
  tenantId       String    @unique @map("tenant_id")
  realmId        String    @map("realm_id") // QBO company ID
  accessToken    String    @map("access_token") // encrypted
  refreshToken   String    @map("refresh_token") // encrypted
  tokenExpiresAt DateTime  @map("token_expires_at")
  lastSyncAt     DateTime? @map("last_sync_at")
  syncStatus     String    @default("idle") // idle | syncing | error
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("qbo_connections")
}

model QboSyncLog {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  syncType      String    @map("sync_type") // invoices | payments | customers | full
  recordsSynced Int       @default(0) @map("records_synced")
  status        String    @default("running") // running | completed | error
  errorMessage  String?   @map("error_message")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  @@index([tenantId, startedAt])
  @@map("qbo_sync_logs")
}

model QboInvoice {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  qboId         String    @map("qbo_id")
  docNumber     String?   @map("doc_number")
  customerName  String    @map("customer_name")
  customerQboId String    @map("customer_qbo_id")
  txnDate       DateTime  @map("txn_date")
  dueDate       DateTime? @map("due_date")
  totalAmt      Decimal   @map("total_amt") @db.Decimal(12, 2)
  balance       Decimal   @map("balance") @db.Decimal(12, 2)
  status        String    @default("open") // open | overdue | paid | voided
  entityId      String?   @map("entity_id") // optional BusinessEntity link for multi-entity CFO rollups
  lastSyncedAt  DateTime  @default(now()) @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  entity BusinessEntity? @relation("QboInvoiceEntity", fields: [entityId], references: [id])

  @@unique([tenantId, qboId])
  @@index([tenantId, status])
  @@index([tenantId, entityId, status])
  @@map("qbo_invoices")
}

model QboPayment {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  qboId         String   @map("qbo_id")
  customerName  String   @map("customer_name")
  customerQboId String   @map("customer_qbo_id")
  txnDate       DateTime @map("txn_date")
  totalAmt      Decimal  @map("total_amt") @db.Decimal(12, 2)
  entityId      String?  @map("entity_id") // optional BusinessEntity link
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  entity BusinessEntity? @relation("QboPaymentEntity", fields: [entityId], references: [id])

  @@unique([tenantId, qboId])
  @@index([tenantId, entityId])
  @@map("qbo_payments")
}

// ──────────────────────────────────────
// JV AGREEMENTS (V2)
// ──────────────────────────────────────

enum JvStatus {
  draft
  active
  completed
  terminated
}

model JvAgreement {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  status          JvStatus  @default(draft)
  description     String?
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  defaultSplitPct Decimal   @default(50) @map("default_split_pct") @db.Decimal(5, 2) // tenant's default share %
  entityId        String?   @map("entity_id") // optional business entity link
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity        BusinessEntity?  @relation(fields: [entityId], references: [id])
  partners      JvPartner[]
  distributions JvDistribution[]
  deals         Deal[]

  @@index([tenantId, status])
  @@map("jv_agreements")
}

model JvPartner {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  agreementId String   @map("agreement_id")
  name        String
  email       String?
  phone       String?
  company     String?
  splitPct    Decimal  @map("split_pct") @db.Decimal(5, 2) // partner's share %
  role        String   @default("partner") // partner | investor | referral
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tokenHash      String?   @map("token_hash")
  tokenExpiresAt DateTime? @map("token_expires_at")
  lastLoginAt    DateTime? @map("last_login_at")

  agreement     JvAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  distributions JvDistribution[]
  sessions      PartnerSession[]

  @@index([tenantId, agreementId])
  @@index([tenantId, email])
  @@map("jv_partners")
}

model JvDistribution {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  agreementId  String    @map("agreement_id")
  partnerId    String    @map("partner_id")
  dealId       String?   @map("deal_id")
  amount       Decimal   @db.Decimal(12, 2)
  partnerShare Decimal   @map("partner_share") @db.Decimal(12, 2)
  tenantShare  Decimal   @map("tenant_share") @db.Decimal(12, 2)
  status       String    @default("pending") // pending | paid | void
  paidAt       DateTime? @map("paid_at")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  agreement JvAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  partner   JvPartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deal      Deal?       @relation(fields: [dealId], references: [id])

  @@index([tenantId, agreementId])
  @@index([tenantId, status])
  @@map("jv_distributions")
}

model PartnerSession {
  id        String   @id @default(uuid())
  partnerId String   @map("partner_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  partner JvPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("partner_sessions")
}

// ──────────────────────────────────────
// SITES & IDX (V1)
// ──────────────────────────────────────

enum SiteStatus {
  draft
  published
  archived
}

model Site {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  name        String
  slug                    String // subdomain or path slug
  domain                  String?    // custom domain (e.g. customer1.com)
  domainVerified          Boolean    @default(false) @map("domain_verified")
  domainVerificationToken String?    @map("domain_verification_token")
  domainVerifiedAt        DateTime?  @map("domain_verified_at")
  status                  SiteStatus @default(draft)
  idxProvider String?    @map("idx_provider") // e.g. "idx_broker", "showcase_idx", "ihomefinder"
  idxApiKey   String?    @map("idx_api_key") // encrypted
  idxConfig   Json?      @map("idx_config") // provider-specific settings
  formId      String?    @map("form_id") // linked lead capture form
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form      Form?          @relation(fields: [formId], references: [id])
  pages     SitePage[]
  blogPosts BlogPost[]
  pageViews SitePageView[]

  @@unique([tenantId, slug])
  @@unique([domain])
  @@index([tenantId, status])
  @@map("sites")
}

model SitePage {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  siteId    String   @map("site_id")
  title     String
  slug      String // page path, e.g. "about", "listings"
  content   Json? // structured page content blocks
  position  Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([tenantId, siteId])
  @@map("site_pages")
}

model SitePageView {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  siteId      String   @map("site_id")
  pagePath    String   @map("page_path") // e.g. /p/brokerage/home
  anonId      String?  @map("anon_id") // localStorage-scoped visitor id
  referrer    String?
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  utmTerm     String?  @map("utm_term")
  utmContent  String?  @map("utm_content")
  userAgent   String?  @map("user_agent") @db.Text
  ip          String?  // hashed or truncated at ingest
  createdAt   DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([tenantId, siteId, createdAt])
  @@index([tenantId, siteId, anonId])
  @@index([tenantId, siteId, utmSource, utmCampaign, createdAt])
  @@map("site_page_views")
}

enum BlogPostStatus {
  draft
  published
}

model BlogPost {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  siteId      String         @map("site_id")
  title       String
  slug        String
  excerpt     String?
  content     String?        @db.Text // HTML or rich text content
  coverImage  String?        @map("cover_image")
  status      BlogPostStatus @default(draft)
  publishedAt DateTime?      @map("published_at")
  author      String // display name
  tags        Json           @default("[]") // JSON array of strings
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([tenantId, siteId, status])
  @@index([tenantId, siteId, slug])
  @@map("blog_posts")
}

// ──────────────────────────────────────
// SOCIAL POSTING & LEAD CAPTURE (V2)
// ──────────────────────────────────────

enum SocialPlatform {
  facebook
  instagram
  linkedin
  twitter
}

enum SocialPostStatus {
  draft
  scheduled
  posting
  posted
  failed
}

model SocialAccount {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  platform       SocialPlatform
  accountName    String         @map("account_name")
  accountId      String         @map("account_id") // platform-specific account/page ID
  accessToken    String         @map("access_token")
  refreshToken   String?        @map("refresh_token")
  tokenExpiresAt DateTime?      @map("token_expires_at")
  avatarUrl      String?        @map("avatar_url")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts  SocialPost[]

  @@unique([tenantId, platform, accountId])
  @@index([tenantId, platform])
  @@map("social_accounts")
}

model SocialPost {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  accountId      String           @map("account_id")
  content        String           @db.Text
  mediaUrls      Json?            @map("media_urls") // string[] of image/video URLs
  status         SocialPostStatus @default(draft)
  scheduledAt    DateTime?        @map("scheduled_at")
  postedAt       DateTime?        @map("posted_at")
  externalPostId String?          @map("external_post_id") // platform post ID after publishing
  errorMessage   String?          @map("error_message")
  engagementData Json?            @map("engagement_data") // likes, shares, comments, etc.
  createdById    String?          @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@map("social_posts")
}

model SocialLeadWebhook {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  platform      SocialPlatform
  webhookSecret String         @map("webhook_secret") // verify inbound webhook signatures
  formId        String?        @map("form_id") // optional: link to existing lead capture form
  isActive      Boolean        @default(true) @map("is_active")
  leadCount     Int            @default(0) @map("lead_count")
  lastLeadAt    DateTime?      @map("last_lead_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form   Form?  @relation(fields: [formId], references: [id])

  @@unique([tenantId, platform])
  @@index([tenantId, isActive])
  @@map("social_lead_webhooks")
}

// ──────────────────────────────────────
// WEBHOOKS (NOT tenant-scoped)
// ──────────────────────────────────────

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String // clerk | stripe | twilio | postmark
  eventType   String    @map("event_type")
  externalId  String    @map("external_id")
  payload     Json
  status      String    @default("pending") // pending | processed | failed | dead_letter
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@index([provider, status])
  @@index([processedAt])
  @@map("webhook_events")
}

model UsageCounter {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  metric    String // monthly_emails | monthly_sms
  period    String // YYYY-MM format (e.g. "2026-03")
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, metric, period])
  @@map("usage_counters")
}

model DemoRequest {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String
  company      String
  businessType String   @map("business_type")
  teamSize     String?  @map("team_size")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("demo_requests")
}

// ──────────────────────────────────────
// FINANCIAL ALERT RULES
// ──────────────────────────────────────

// ──────────────────────────────────────
// MOAT: COMMISSION SPLITS + HOUSEHOLDS
// Cross-line-of-business revenue attribution that no RE-only CRM does.
// ──────────────────────────────────────

enum CommissionPayeeType {
  user        // internal agent / LO / producer
  contact     // referral partner, split with another firm
  entity      // house account, JV entity, corporate
}

enum CommissionSource {
  real_estate
  mortgage
  insurance
  investment
  other
}

model CommissionSplit {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  dealId       String?             @map("deal_id")
  source       CommissionSource
  payeeType    CommissionPayeeType @map("payee_type")
  payeeUserId  String?             @map("payee_user_id")
  payeeContactId String?           @map("payee_contact_id")
  payeeEntityId String?            @map("payee_entity_id")
  percentBps   Int                 @map("percent_bps") // basis points, 10000 = 100%
  amountCents  BigInt              @map("amount_cents")
  paidAt       DateTime?           @map("paid_at")
  note         String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([tenantId, dealId])
  @@index([tenantId, source, createdAt])
  @@index([tenantId, payeeUserId, paidAt])
  @@map("commission_splits")
}

model Household {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  primaryContactId String? @unique @map("primary_contact_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members HouseholdMember[]

  @@index([tenantId, name])
  @@map("households")
}

model HouseholdMember {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  householdId String   @map("household_id")
  contactId   String   @map("contact_id")
  role        String   @default("member") // primary | spouse | partner | dependent | member
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, contactId])
  @@index([tenantId, contactId])
  @@map("household_members")
}

model AlertRule {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  type            AlertRuleType
  thresholdValue  Decimal       @map("threshold_value") @db.Decimal(12, 2)
  thresholdUnit   String        @map("threshold_unit") // percent | days | amount
  enabled         Boolean       @default(true)
  lastTriggeredAt DateTime?     @map("last_triggered_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, enabled])
  @@map("alert_rules")
}
